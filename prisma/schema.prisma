generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  name      String
  nisNip    String   @unique
  password  String
  role      String   // "GURU" or "SISWA"
  kelasId   String?
  kelas     Kelas?   @relation(fields: [kelasId], references: [id])
  nilai     Nilai[]
  absensi   Absensi[]
}

model Kelas {
  id    String @id @default(cuid())
  nama  String // e.g., "XI F1"
  siswa User[]
}

model Nilai {
  id        String @id @default(cuid())
  siswaId   String
  siswa     User   @relation(fields: [siswaId], references: [id])
  jenis     String // "KEHADIRAN", "CATATAN", "ULANGAN", "SIKAP"
  skor      Float
  keterangan String?
}

model Absensi {
  id        String   @id @default(cuid())
  siswaId   String
  siswa     User     @relation(fields: [siswaId], references: [id])
  tanggal   DateTime @default(now())
  status    String   // "H", "S", "I", "A"
}