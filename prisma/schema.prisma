generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  nisNip    String   @unique
  password  String
  role      String   // "GURU" atau "SISWA"
  kelasId   String?
  kelas     Kelas?   @relation(fields: [kelasId], references: [id])
  Absensi   Absensi[]
}

model Kelas {
  id     String  @id @default(cuid())
  nama   String  @unique
  users  User[]
}

model Absensi {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tanggal   DateTime @default(now())
  status    String   // "HADIR", "IZIN", "SAKIT", "ALPHA"
  keterangan String?
}
